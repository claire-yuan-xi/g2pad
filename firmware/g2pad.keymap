/*
 * G2Pad keymap (ZMK)
 *
 *   +----------+----------+
 *   | BACK  Q  |  UP   W  |      tap  = letter key (works with any phone input handler)
 *   +----------+----------+      hold = long-press action
 *   | SELECT E |  DOWN  S |
 *   +----------+----------+
 *
 *  Long presses (hold > 400 ms):
 *    BACK   -> H  (home)
 *    SELECT -> M  (shortcut / menu)
 *  Combos:
 *    UP + DOWN        -> toggle NAV mode (arrow keys / Enter / Esc, for apps that want them)
 *    BACK + SELECT    -> hold for BT layer (UP = next paired device, DOWN = clear pairing)
 *
 *  The Even Hub app on the phone decides what each letter does on the G2.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NAV  1
#define BT   2

/ {
    behaviors {
        lp: long_press {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        nav_toggle {
            timeout-ms = <80>;
            key-positions = <1 3>;
            bindings = <&tog NAV>;
        };
        bt_layer {
            timeout-ms = <80>;
            key-positions = <0 2>;
            bindings = <&mo BT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "G2";
            bindings = <
                &lp H Q     &kp W
                &lp M E     &kp S
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
                &kp ESC     &kp UP
                &kp RET     &kp DOWN
            >;
        };

        bt_layer {
            display-name = "BT";
            bindings = <
                &trans      &bt BT_NXT
                &trans      &bt BT_CLR
            >;
        };
    };
};
